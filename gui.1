# Fantasy Football GUI - Maximum Compression
import tkinter as tk
from tkinter import ttk, messagebox as mb
import game

class ModernButton(tk.Canvas):
    def __init__(self, p, t, c, bg="#6B46C1", fg="white", w=200, h=50):
        super().__init__(p, width=w, height=h, highlightthickness=0, bg=p['bg'])
        self.bg, self.hbg = bg, "#8B5CF6"
        pts = lambda x1,y1,x2,y2,r=25: [x1+r,y1,x2-r,y1,x2,y1,x2,y1+r,x2,y2-r,x2,y2,x2-r,y2,x1+r,y2,x1,y2,x1,y2-r,x1,y1+r,x1,y1]
        self.r = self.create_polygon(pts(5,5,w-5,h-5), smooth=True, fill=bg)
        self.create_text(w/2, h/2, text=t, fill=fg, font=("Segoe UI", 13, "bold"))
        self.bind("<Enter>", lambda e: self.itemconfig(self.r, fill=self.hbg))
        self.bind("<Leave>", lambda e: self.itemconfig(self.r, fill=self.bg))
        self.bind("<Button-1>", lambda e: c())

class FantasyFootballGUI:
    def __init__(self, r):
        self.root = r
        r.title("Fantasy Premier League")
        r.geometry("1000x750")
        r.configure(bg='#37003C')
        tk.Canvas.rr = lambda s,x1,y1,x2,y2,r=25,**k: s.create_polygon([x1+r,y1,x2-r,y1,x2,y1,x2,y1+r,x2,y2-r,x2,y2,x2-r,y2,x1+r,y2,x1,y2,x1,y2-r,x1,y1+r,x1,y1],smooth=True,**k)
        self.ml = game.loadPlayers("Players.txt")
        self.t, self.b, self.s11, self.cap = [], 100.0, [], -1
        self.tr, self.gw = game.TRANSFERS_PER_WEEK, game.CURRENT_GAMEWEEK
        self.setup()
    
    def l(self, p, txt, sz, b=0, c='#37003C', bg='#FFF'):
        return tk.Label(p, text=txt, font=("Segoe UI",sz,"bold" if b else ""), bg=bg, fg=c)
    
    def setup(self):
        [w.destroy() for w in self.root.winfo_children()]
        m = tk.Frame(self.root, bg='#37003C')
        m.pack(fill='both', expand=True)
        h = tk.Frame(m, bg='#37003C')
        h.pack(pady=20)
        self.l(h, "⚽ FANTASY", 36, 1, '#FFF', '#37003C').pack()
        self.l(h, "PREMIER LEAGUE", 18, 1, '#0F7', '#37003C').pack()
        
        cc = tk.Canvas(m, height=280, width=860, bg='#37003C', highlightthickness=0)
        cc.pack(pady=20)
        cc.rr(10,10,850,270,30,fill='#FFF',outline='')
        gc = tk.Canvas(cc, height=70, bg='#FFF', highlightthickness=0)
        cc.create_window(430,40, window=gc, width=820, height=70)
        gc.rr(5,5,815,65,25,fill='#37003C',outline='')
        gc.create_window(410,35, window=self.l(gc,f"GAMEWEEK {self.gw}",20,1,'#FFF','#37003C'))
        sc = tk.Frame(cc, bg='#FFF')
        cc.create_window(430,165, window=sc)
        
        for i,(v,lbl,clr) in enumerate([(game.calcTotalScore(self.t),"TOTAL POINTS",'#37003C'),(f"{len(self.t)}/15","PLAYERS",'#37003C'),(f"£{self.b:.1f}m","BUDGET",'#0B4')]):
            f = tk.Frame(sc, bg='#FFF')
            f.pack(side='left', padx=40 if i==1 else 60)
            self.l(f, str(v), 52 if i==0 else 32, 1, clr).pack()
            self.l(f, lbl, 11 if i==0 else 10, i==0, '#666').pack()
        
        bc = tk.Frame(m, bg='#37003C')
        bc.pack(pady=30)
        pb = tk.Frame(bc, bg='#37003C')
        pb.pack()
        [ModernButton(pb, t, c, bg, fg, 280, 70).pack(pady=8) for t,c,bg,fg in [("🎽 PICK TEAM",self.pick,'#0F7','#37003C'),("💰 TRANSFERS",self.trans,'#E90052','#FFF')]]
        sb = tk.Frame(bc, bg='#37003C')
        sb.pack(pady=15)
        [ModernButton(sb, t, c, '#FFF', '#37003C', 280, 55).pack(pady=5) for t,c in [("📊 VIEW MARKET",self.market),("⚡ SIMULATE GAMEWEEK",self.sim)]]
        self.l(m, f"Transfers Left: {self.tr} • Starting XI: {'✓' if self.s11 else '✗'} • Captain: {'✓' if self.cap>=0 else '✗'}", 10, 0, '#AAA', '#37003C').pack(side='bottom', pady=20)
    
    def market(self):
        w = tk.Toplevel(self.root)
        w.title("Player Market")
        w.geometry("1100x700")
        w.configure(bg='#F4F4F4')
        h = tk.Frame(w, bg='#37003C', height=80)
        h.pack(fill='x')
        self.l(h, "PLAYER MARKET", 24, 1, '#FFF', '#37003C').pack(pady=20)
        sc = tk.Canvas(w, height=90, bg='#F4F4F4', highlightthickness=0)
        sc.pack(fill='x', padx=30, pady=20)
        sc.rr(5,5,1040,85,20,fill='#FFF',outline='#DDD',width=2)
        scf = tk.Frame(sc, bg='#FFF')
        sc.create_window(520,45, window=scf)
        self.l(scf, "🔍 Search:", 11, 1).pack(side='left', padx=5)
        se = tk.Entry(scf, font=("Segoe UI",12), width=25, relief='solid', bd=2)
        se.pack(side='left', padx=10, ipady=8)
        self.l(scf, "Position:", 11, 1).pack(side='left', padx=15)
        pv = tk.StringVar(value="All")
        pm = ttk.Combobox(scf, textvariable=pv, values=["All","Goalkeeper","Defender","Midfielder","Striker"], state='readonly', width=12)
        pm.pack(side='left', padx=5)
        tf = tk.Frame(w, bg='#FFF')
        tf.pack(fill='both', expand=True, padx=30, pady=10)
        s = ttk.Style()
        s.theme_use('clam')
        s.configure("Treeview", background="#FFF", foreground="#37003C", rowheight=35, font=("Segoe UI",10))
        s.configure("Treeview.Heading", background="#37003C", foreground="#FFF", font=("Segoe UI",11,"bold"))
        s.map('Treeview', background=[('selected','#0F7')])
        cols = ("Name","Price","Position","Total Pts","GW Pts")
        tr = ttk.Treeview(tf, columns=cols, show='headings', height=15)
        ttk.Scrollbar(tf, command=tr.yview).pack(side='right', fill='y')
        tr.configure(yscrollcommand=ttk.Scrollbar(tf).set)
        [tr.heading(c, text=c.upper()) or tr.column(c, width=wi) for c,wi in zip(cols,[250,120,150,120,120])]
        tr.pack(fill='both', expand=True)
        
        def upd():
            tr.delete(*tr.get_children())
            st = se.get().lower()
            pf = pv.get()
            [tr.insert('','end',values=(p['name'],f"£{p['price']:.1f}m",p['position'],p['points'],p['gw_points'])) for p in self.ml if (not st or st in p['name'].lower()) and (pf=="All" or p['position']==pf)]
        
        se.bind('<KeyRelease>', lambda e: upd())
        pm.bind('<<ComboboxSelected>>', lambda e: upd())
        upd()
        
        def buy():
            sel = tr.selection()
            if not sel:
                mb.showwarning("Warning","Please select a player!")
                return
            idx = game.searchPlayer(tr.item(sel[0])['values'][0], self.ml)
            if idx != -1:
                suc, self.b, msg, self.tr = game.buyPlayer(self.t, self.ml[idx], self.b, self.tr)
                mb.showinfo("Result", msg)
                if suc:
                    w.destroy()
                    self.setup()
        
        ModernButton(w, "BUY PLAYER", buy, '#0F7', '#37003C', 250, 60).pack(pady=20)
    
    def pick(self):
        if len(self.t) < 11:
            mb.showwarning("Warning", f"You need at least 11 players! You have {len(self.t)}")
            return
        w = tk.Toplevel(self.root)
        w.title("Pick Team")
        w.geometry("1000x800")
        w.configure(bg='#37003C')
        h = tk.Frame(w, bg='#37003C')
        h.pack()
        self.l(h, "PICK YOUR TEAM", 26, 1, '#FFF', '#37003C').pack(pady=15)
        self.l(h, f"Gameweek {self.gw}", 14, 0, '#0F7', '#37003C').pack()
        p = tk.Canvas(w, bg='#0B4', highlightthickness=0)
        p.pack(fill='both', expand=True, padx=20, pady=20)
        wd, ht = 960, 550
        p.rr(25,25,wd-25,ht-25,25,fill='#083',outline='')
        p.rr(30,30,wd-30,ht-30,20,fill='#0B4',outline='white',width=3)
        p.create_line(wd/2,30,wd/2,ht-30,fill='white',width=2)
        p.create_oval(wd/2-80,ht/2-80,wd/2+80,ht/2+80,outline='white',width=2)
        p.create_oval(wd/2-8,ht/2-8,wd/2+8,ht/2+8,fill='white',outline='white')
        
        def disp():
            if not self.s11: return
            p.delete("player")
            ps = {'Goalkeeper':[],'Defender':[],'Midfielder':[],'Striker':[]}
            [ps[self.t[i]['position']].append(i) for i in self.s11]
            for pos,y in [('Goalkeeper',500),('Defender',380),('Midfielder',240),('Striker',100)]:
                pl = ps[pos]
                if not pl: continue
                sx = (wd-(len(pl)-1)*200)/2
                for i,idx in enumerate(pl):
                    x = sx+i*200
                    cp = idx==self.cap
                    cl = '#E90052' if cp else '#37003C'
                    p.create_oval(x-35,y-35,x+35,y+35,fill=cl,outline='white',width=3,tags="player")
                    p.create_text(x,y-55,text=self.t[idx]['name'].split()[-1][:10],fill='white',font=("Segoe UI",11,"bold"),tags="player")
                    if cp: p.create_text(x,y,text="C",fill='white',font=("Segoe UI",16,"bold"),tags="player")
        
        disp()
        bc = tk.Frame(w, bg='#37003C')
        bc.pack(pady=15)
        
        def s11():
            self.s11 = game.selectStarting11(self.t)
            if self.s11:
                mb.showinfo("Success","Starting 11 selected!")
                w.destroy()
                self.pick()
        
        def scap():
            if not self.s11:
                mb.showwarning("Warning","Please select starting 11 first!")
                return
            self.cap = game.selectCaptain(self.t, self.s11)
            if self.cap >= 0:
                mb.showinfo("Success",f"✓ {self.t[self.cap]['name']} is your captain!")
                w.destroy()
                self.pick()
        
        ModernButton(bc, "SELECT STARTING 11", s11, '#0F7', '#37003C', 240, 55).pack(side='left', padx=10)
        ModernButton(bc, "SELECT CAPTAIN", scap, '#E90052', '#FFF', 240, 55).pack(side='left', padx=10)
    
    def trans(self):
        w = tk.Toplevel(self.root)
        w.title("Transfers")
        w.geometry("1000x750")
        w.configure(bg='#F4F4F4')
        h = tk.Frame(w, bg='#37003C', height=120)
        h.pack(fill='x')
        self.l(h, "TRANSFERS", 26, 1, '#FFF', '#37003C').pack(pady=20)
        self.l(h, f"Free Transfers: {self.tr}  •  Budget: £{self.b:.1f}m", 13, 0, '#0F7', '#37003C').pack()
        cf = tk.Frame(w, bg='#F4F4F4')
        cf.pack(fill='both', expand=True, padx=30, pady=20)
        tc = tk.Canvas(cf, height=70, bg='#F4F4F4', highlightthickness=0)
        tc.pack(fill='x', pady=(0,10))
        tc.rr(5,5,935,65,15,fill='#FFF',outline='')
        tc.create_window(470,35, window=self.l(tc,"YOUR TEAM",16,1))
        cols = ("Name","Price","Position","Points")
        tr = ttk.Treeview(cf, columns=cols, show='headings', height=12)
        [tr.heading(c, text=c.upper()) or tr.column(c, width=wi) for c,wi in zip(cols,[300,150,150,150])]
        tr.pack(fill='both', expand=True, pady=10)
        [tr.insert('','end',values=(pl['name'],f"£{pl['price']:.1f}m",pl['position'],pl['points'])) for pl in self.t]
        
        def sell():
            sel = tr.selection()
            if not sel:
                mb.showwarning("Warning","Please select a player to sell!")
                return
            pn = tr.item(sel[0])['values'][0]
            for i,p in enumerate(self.t):
                if p['name'] == pn:
                    rf = game.sellPlayer(self.t, i)
                    self.b += rf
                    self.s11, self.cap = [], -1
                    mb.showinfo("Success", f"Player sold! Refund: £{rf:.1f}m")
                    w.destroy()
                    self.setup()
                    return
        
        bc = tk.Frame(w, bg='#F4F4F4')
        bc.pack(pady=20)
        ModernButton(bc, "SELL PLAYER", sell, '#E90052', '#FFF', 220, 60).pack(side='left', padx=10)
        ModernButton(bc, "BUY PLAYER", lambda: (w.destroy(), self.market()), '#0F7', '#37003C', 220, 60).pack(side='left', padx=10)
    
    def sim(self):
        if not self.s11 or self.cap == -1:
            mb.showwarning("Warning", "Please select your starting 11 and captain first!")
            return
        game.simulateGameweek(self.ml)
        for i,p in enumerate(self.t):
            for mp in self.ml:
                if p['name'] == mp['name']:
                    self.t[i]['gw_points'] = mp['gw_points']
                    self.t[i]['points'] = mp['points']
        gws = game.calculateGameweekScore(self.t, self.s11, self.cap)
        mb.showinfo("Gameweek Results", f"⚽ GAMEWEEK {self.gw} COMPLETE!\n\nYour Score: {gws} points\n\nCaptain {self.t[self.cap]['name']} points were doubled!")
        self.gw += 1
        game.CURRENT_GAMEWEEK = self.gw
        self.tr = game.TRANSFERS_PER_WEEK
        self.s11, self.cap = [], -1
        if self.gw > game.MAX_GAMEWEEKS:
            mb.showinfo("Season Complete", f"🏆 SEASON COMPLETE! 🏆\n\nFinal Score: {game.calcTotalScore(self.t)} points\n\nCongratulations!")
            self.root.quit()
        else:
            self.setup()

if __name__ == "__main__":
    root = tk.Tk()
    FantasyFootballGUI(root)
    root.mainloop()